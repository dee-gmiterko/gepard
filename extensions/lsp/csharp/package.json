        },
        "linux-arm64": {
          "rid": "linux-arm64",
          "sha512": "9bt2QoOsiOsaKPfur3Gw3J3QwG1PmcArsPrkJQdgHn6x7iemNVhU+wdDh1Vae8dk6GEwdHxQTjxueTKa02z7wA=="
        },
        "darwin-x64": {
          "rid": "osx-x64",
          "sha512": "JqwerZUk87mWVOexcQ6hNw0l90URq+qjWBi5ZxPTdTVfMwDgg2QJU96KoesJ5VSwApzyWuXsZgrHq7kecNWflA=="
        },
        "darwin-arm64": {
          "rid": "osx-arm64",
          "sha512": "NH91bgilgYq2mMfagKCn6uBsTWVkSO7sLD+PomIm0Fp+s7HqASKZZiY4uE9yaFJ5AnJEJguZd7iZgShVQMDZqQ=="
        },
        "win32-x64": {
          "rid": "win-x64",
          "sha512": "BTuCo+sIfXQ9+0ocb18CS6WLqVAzG4DqViQ1L6suxiweGzTwpTU8T5Zf/aAscWhOVebInJleMRVq0Q8dxZb6bA=="
