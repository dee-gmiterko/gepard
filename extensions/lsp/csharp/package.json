{
  "name": "gepard-ext-csharp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bundled C# language extension for Gepard (vendored Roslyn language server).",
  "main": "dist/index.js",
  "gepard": {
    "type": "lsp",
    "vendor": {
      "package": "roslyn-language-server",
      "version": "5.12.0-1.26475.2",
      "assets": {
        "linux-x64": {
