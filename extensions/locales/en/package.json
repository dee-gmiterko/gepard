{
  "name": "gepard-locale-en",
  "version": "0.1.0",
  "private": true,
  "description": "Built-in English locale extension for Gepard.",
  "main": "index.mjs",
  "gepard": {
    "type": "locale"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@gepard/common": "workspace:*",
    "@gepard/eslint-config": "workspace:*",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  }
}
