{
  "name": "gepard-grammar-godot",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Syntax highlighting for GDScript, Godot scene and resource files and shaders.",
  "main": "dist/index.js",
  "files": [
    "dist",
    "THIRD_PARTY_LICENSES"
  ],
  "gepard": {
    "type": "grammar",
    "displayName": "Godot"
  },
  "scripts": {
    "build": "esbuild index.ts --bundle --format=esm --target=es2023 --outfile=dist/index.js --log-level=warning",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@codemirror/language": "^6.12.4",
    "@gepard/common": "workspace:^",
    "@gepard/eslint-config": "workspace:^",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.10",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
