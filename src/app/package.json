{
  "name": "gepard",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Gepard - Great Pull Request Review Tool",
  "main": "./out/main/index.js",
  "desktopName": "io.github.dee-gmiterko.gepard.desktop",
  "author": "d.gmiterko@gmail.com",
  "homepage": "https://github.com/dee-gmiterko/gepard",
  "repository": {
    "type": "git",
    "url": "https://github.com/dee-gmiterko/gepard"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "yarn build && electron-builder --mac",
    "build:linux": "yarn build && electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "mime-types": "^3.0.2",
    "picomatch": "^4.0.7",
    "vscode-jsonrpc": "^9.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@gepard/common": "workspace:^",
    "@gepard/eslint-config": "workspace:^",
    "@gepard/main": "workspace:^",
    "@gepard/preload": "workspace:^",
    "@gepard/renderer": "workspace:^",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
