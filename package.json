{
  "name": "gh-large-review",
  "version": "0.1.0",
  "description": "GitHub large PR review desktop app",
  "main": "./out/main/index.js",
  "author": "d.gmiterko@gmail.com",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "yarn typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "yarn build && electron-builder --dir",
    "build:win": "yarn build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron-toolkit/utils": "^4.0.0",
    "@lezer/highlight": "^1.2.0",
    "@tanstack/react-query": "5.103.2",
    "@vscode/ripgrep": "1.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-feather": "2.0.10",
    "styled-components": "6.5.3",
    "typescript-language-server": "6.0.1",
    "vscode-jsonrpc": "9.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "packageManager": "yarn@4.18.1",
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2",
    "@typescript/typescript-win32-arm64": "7.0.2",
    "@typescript/typescript-win32-x64": "7.0.2"
  }
}
