{
  "name": "gepard-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/dee-gmiterko/gepard",
  "repository": {
    "type": "git",
    "url": "https://github.com/dee-gmiterko/gepard"
  },
  "scripts": {
    "dev": "yarn workspace gepard run dev",
    "start": "yarn workspace gepard run start",
    "build": "yarn workspace gepard run build",
    "build:unpack": "yarn workspace gepard run build:unpack",
    "build:win": "yarn workspace gepard run build:win",
    "build:mac": "yarn workspace gepard run build:mac",
    "build:linux": "turbo run build && yarn workspace gepard run build:linux",
    "test": "turbo run test && vitest run",
    "typecheck": "turbo run typecheck",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "lint": "turbo run lint",
    "lint:scripts": "eslint --config scripts/eslint.config.mjs scripts",
    "format": "turbo run format format:scripts",
    "format:scripts": "prettier --write scripts",
    "format:check": "turbo run format:check format:check:scripts",
    "format:check:scripts": "prettier --check scripts",
    "barrels:refresh": "bash scripts/refresh-barrels.sh",
    "locales:refresh": "tsx scripts/refresh-locales.ts",
    "locales:check": "tsx scripts/refresh-locales.ts --check",
    "media:refresh": "tsx scripts/refresh-media.ts",
    "validate": "turbo run typecheck lint format:check typecheck:scripts lint:scripts format:check:scripts && yarn locales:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@formatjs/cli": "6.16.32",
    "@gepard/eslint-config": "workspace:*",
    "@types/node": "24.19.0",
    "@types/yargs": "17.0.35",
    "barrelsby": "2.8.1",
    "eslint": "9.39.5",
    "husky": "^9.1.7",
    "png2icons": "2.0.1",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "tsx": "4.23.15",
    "turbo": "^2",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.2",
    "yargs": "18.2.0"
  },
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "src/*",
    "extensions/*/*",
    "tools/*"
  ]
}
