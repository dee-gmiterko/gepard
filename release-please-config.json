{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": false,
  "pull-request-header": "Release notes for the next version.",
  "pull-request-footer": "Merge this pull request to tag the release.",
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "json",
          "path": "src/app/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src/common/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src/main/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src/preload/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "src/renderer/package.json",
          "jsonpath": "$.version"
        }
      ],
      "exclude-paths": ["extensions"]
    },
    "extensions/grammars/godot": {
      "component": "gepard-grammar-godot",
      "include-component-in-tag": true
    },
    "extensions/locales/en": {
      "component": "gepard-locale-en",
      "include-component-in-tag": true
    },
    "extensions/lsp/cpp": {
      "component": "gepard-ext-cpp",
      "include-component-in-tag": true
    },
    "extensions/lsp/csharp": {
      "component": "gepard-ext-csharp",
      "include-component-in-tag": true
    },
    "extensions/lsp/gdscript": {
      "component": "gepard-ext-gdscript",
      "include-component-in-tag": true
    },
    "extensions/lsp/java": {
      "component": "gepard-ext-java",
      "include-component-in-tag": true
    },
    "extensions/lsp/php": {
      "component": "gepard-ext-php",
      "include-component-in-tag": true
    },
    "extensions/lsp/python": {
      "component": "gepard-ext-python",
      "include-component-in-tag": true
    },
    "extensions/lsp/typescript": {
      "component": "gepard-ext-typescript",
      "include-component-in-tag": true
    },
    "extensions/themes/dark": {
      "component": "gepard-theme-dark",
      "include-component-in-tag": true
    },
    "extensions/themes/dark-high-contrast": {
      "component": "gepard-theme-dark-high-contrast",
      "include-component-in-tag": true
    },
    "extensions/themes/light": {
      "component": "gepard-theme-light",
      "include-component-in-tag": true
    },
    "extensions/themes/light-high-contrast": {
      "component": "gepard-theme-light-high-contrast",
      "include-component-in-tag": true
    }
  },
  "separate-pull-requests": true
}
