{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!LICENSE",
        "!THIRD_PARTY_LICENSES",
        "!UPSTREAM_LICENSE",
        "!eslint.config.mjs",
        "!.prettierignore",
        "!test/**"
      ],
      "outputs": ["dist/**"]
    },
    "gepard#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!eslint.config.mjs",
        "!.prettierignore",
        "!electron-builder.yml",
        "!build/**"
      ],
      "outputs": ["out/**"]
    },
    "//#extensions:bundle": {
      "inputs": [
        "scripts/bundle-extensions.ts",
        "extensions/themes/*/**",
        "extensions/locales/en/**"
      ],
      "outputs": ["src/app/extensions-dist/**"]
    },
    "package:unpack": {
      "dependsOn": ["build", "//#extensions:bundle"],
      "cache": false
    },
    "package:win": {
      "dependsOn": ["build", "//#extensions:bundle"],
      "cache": false
    },
    "package:mac": {
      "dependsOn": ["build", "//#extensions:bundle"],
      "cache": false
    },
    "package:linux": {
      "dependsOn": ["build", "//#extensions:bundle"],
      "cache": false
    },
    "//#typecheck:scripts": {
      "inputs": ["scripts/**", "vitest.config.ts", "package.json"]
    },
    "//#locales:check": {
      "inputs": [
        "scripts/refresh-locales.ts",
        "extensions/locales/**",
        "src/renderer/src/**/*.{ts,tsx}",
        "package.json"
      ]
    },
    "//#barrels:check": {
      "inputs": ["scripts/refresh-barrels.sh", "src/common/**", "src/common-lsp/**", "package.json"]
    },
    "validate": {
      "dependsOn": [
        "typecheck",
        "lint",
        "format:check",
        "//#typecheck:scripts",
        "//#lint:scripts",
        "//#format:check:scripts",
        "//#locales:check",
        "//#barrels:check"
      ]
    },
    "//#format:scripts": {
      "cache": false
    },
    "//#format:check:scripts": {
      "inputs": ["scripts/**", "$TURBO_ROOT$/.prettierrc.yaml", "$TURBO_ROOT$/.editorconfig"]
    },
    "//#lint:scripts": {
      "inputs": ["scripts/**", "$TURBO_ROOT$/tools/eslint-config/**", "package.json"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!LICENSE",
        "!THIRD_PARTY_LICENSES",
        "!UPSTREAM_LICENSE",
        "!eslint.config.mjs",
        "!.prettierignore",
        "!test/fixtures/**"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!LICENSE",
        "!THIRD_PARTY_LICENSES",
        "!UPSTREAM_LICENSE",
        "!.prettierignore",
        "!test/fixtures/**"
      ]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/fixtures/**",
        "$TURBO_ROOT$/.prettierrc.yaml",
        "$TURBO_ROOT$/.editorconfig"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!LICENSE",
        "!THIRD_PARTY_LICENSES",
        "!UPSTREAM_LICENSE",
        "!eslint.config.mjs",
        "!.prettierignore"
      ]
    }
  }
}
